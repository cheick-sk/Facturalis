{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..", // Points to the backend root directory
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$", // Specifically for integration tests
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1" // Alias for src path
  },
  "globals": {
    "ts-jest": {
      "tsconfig": "<rootDir>/tsconfig.json"
    }
  }
}
