// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  phoneNumber   String?
  dateOfBirth   DateTime? @db.Date
  hireDate      DateTime  @default(now()) @db.Date
  jobTitle      String?
  department    String?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  timesheetEntries TimesheetEntry[] // Relation to TimesheetEntry
  leaveRequests    LeaveRequest[]   // Relation to LeaveRequest (for future module)
  absences         Absence[]        // Relation to Absence (for future module)
}

model Project {
  id          String    @id @default(cuid())
  name        String    @unique
  clientName  String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks            Task[]           // Relation to Task
  timesheetEntries TimesheetEntry[] // Relation to TimesheetEntry
}

model Task {
  id          String    @id @default(cuid())
  name        String
  description String?
  projectId   String    // Relation to Project
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timesheetEntries TimesheetEntry[] // Relation to TimesheetEntry

  @@unique([name, projectId]) // Task name should be unique within a project
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  startTime   DateTime  // Could be just time, but DateTime is fine for Prisma
  endTime     DateTime  // Could be just time
  duration    Float     // Duration in hours, e.g., 1.5 for 1h 30m
  notes       String?   @db.Text

  employeeId  String    // Relation to Employee
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId   String?   // Optional relation to Project
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull) // SetNull if project deleted

  taskId      String?   // Optional relation to Task
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)   // SetNull if task deleted

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, date]) // Index for querying timesheets by employee and date
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                 String  @id @default(cuid())
  name               String  @unique // e.g., Annual, Sick, Unpaid
  description        String? @db.Text
  defaultDaysAllowed Float?  // Default number of days allowed per year for this type, can be overridden in LeaveBalance

  leaveRequests      LeaveRequest[] // Relation to LeaveRequest
  leaveBalances      LeaveBalance[] // Relation to LeaveBalance
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model LeaveRequest {
  id           String             @id @default(cuid())
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  reason       String?            @db.Text
  status       LeaveRequestStatus @default(PENDING)
  requestedAt  DateTime           @default(now())
  approvedAt   DateTime?
  comments     String?            @db.Text // Comments by employee or approver

  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId  String
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict) // Prevent deleting LeaveType if requests exist

  approverId   String?            // ID of the employee who approved/rejected
  approver     Employee?          @relation("ApprovedLeaveRequests", fields: [approverId], references: [id], onDelete: SetNull)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId, status])
  @@index([leaveTypeId])
}

model LeaveBalance {
  id                String    @id @default(cuid())
  year              Int       // The year this balance applies to
  totalDaysAllowed  Float     // Total days allocated for the year for this leave type
  daysTaken         Float     @default(0)
  // daysRemaining can be a calculated field in the application logic or a view in DB

  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId       String
  leaveType         LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade) // If type deleted, balance is too

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year]) // Ensures one balance entry per employee, per leave type, per year
}


enum AbsenceStatus {
  REPORTED    // Absence reported, pending details or justification
  JUSTIFIED   // Justification provided and accepted
  UNJUSTIFIED // No valid justification, or justification rejected
  EXCUSED     // Excused by management for specific reasons
}

model AbsenceType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., Uncertified Sick Leave, Urgent Personal Matter, Late Arrival
  description String?  @db.Text
  absences    Absence[] // Relation to Absence
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Absence {
  id          String        @id @default(cuid())
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date // For single day absence, endDate will be same as startDate
  reason      String?       @db.Text  // Free text reason if no AbsenceType or for additional details
  status      AbsenceStatus @default(REPORTED)
  notes       String?       @db.Text  // Additional notes by manager or employee

  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  absenceTypeId String?     // Optional relation to a predefined absence type
  absenceType   AbsenceType? @relation(fields: [absenceTypeId], references: [id], onDelete:SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([employeeId, startDate])
  @@index([absenceTypeId])
}
