// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  phoneNumber   String?
  dateOfBirth   DateTime? @db.Date
  hireDate      DateTime  @default(now()) @db.Date
  jobTitle      String?
  department    String?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  timesheetEntries TimesheetEntry[] // Relation to TimesheetEntry
  leaveRequests    LeaveRequest[]   // Relation to LeaveRequest (for future module)
  absences         Absence[]        // Relation to Absence (for future module)
}

model Project {
  id          String    @id @default(cuid())
  name        String    @unique
  clientName  String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks            Task[]           // Relation to Task
  timesheetEntries TimesheetEntry[] // Relation to TimesheetEntry
}

model Task {
  id          String    @id @default(cuid())
  name        String
  description String?
  projectId   String    // Relation to Project
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timesheetEntries TimesheetEntry[] // Relation to TimesheetEntry

  @@unique([name, projectId]) // Task name should be unique within a project
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  startTime   DateTime  // Could be just time, but DateTime is fine for Prisma
  endTime     DateTime  // Could be just time
  duration    Float     // Duration in hours, e.g., 1.5 for 1h 30m
  notes       String?   @db.Text

  employeeId  String    // Relation to Employee
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId   String?   // Optional relation to Project
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull) // SetNull if project deleted

  taskId      String?   // Optional relation to Task
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)   // SetNull if task deleted

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, date]) // Index for querying timesheets by employee and date
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                 String  @id @default(cuid())
  name               String  @unique // e.g., Annual, Sick, Unpaid
  description        String? @db.Text
  defaultDaysAllowed Float?  // Default number of days allowed per year for this type, can be overridden in LeaveBalance

  leaveRequests      LeaveRequest[] // Relation to LeaveRequest
  leaveBalances      LeaveBalance[] // Relation to LeaveBalance
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model LeaveRequest {
  id           String             @id @default(cuid())
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  reason       String?            @db.Text
  status       LeaveRequestStatus @default(PENDING)
  requestedAt  DateTime           @default(now())
  approvedAt   DateTime?
  comments     String?            @db.Text // Comments by employee or approver

  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId  String
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict) // Prevent deleting LeaveType if requests exist

  approverId   String?            // ID of the employee who approved/rejected
  approver     Employee?          @relation("ApprovedLeaveRequests", fields: [approverId], references: [id], onDelete: SetNull)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId, status])
  @@index([leaveTypeId])
}

model LeaveBalance {
  id                String    @id @default(cuid())
  year              Int       // The year this balance applies to
  totalDaysAllowed  Float     // Total days allocated for the year for this leave type
  daysTaken         Float     @default(0)
  // daysRemaining can be a calculated field in the application logic or a view in DB

  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId       String
  leaveType         LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade) // If type deleted, balance is too

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year]) // Ensures one balance entry per employee, per leave type, per year
}


enum AbsenceStatus {
  REPORTED    // Absence reported, pending details or justification
  JUSTIFIED   // Justification provided and accepted
  UNJUSTIFIED // No valid justification, or justification rejected
  EXCUSED     // Excused by management for specific reasons
}

model AbsenceType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., Uncertified Sick Leave, Urgent Personal Matter, Late Arrival
  description String?  @db.Text
  absences    Absence[] // Relation to Absence
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Absence {
  id          String        @id @default(cuid())
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date // For single day absence, endDate will be same as startDate
  reason      String?       @db.Text  // Free text reason if no AbsenceType or for additional details
  status      AbsenceStatus @default(REPORTED)
  notes       String?       @db.Text  // Additional notes by manager or employee

  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  absenceTypeId String?     // Optional relation to a predefined absence type
  absenceType   AbsenceType? @relation(fields: [absenceTypeId], references: [id], onDelete:SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([employeeId, startDate])
  @@index([absenceTypeId])
}

// --- Payroll & Benefits Module ---

enum PayrollCycleFrequency {
  MONTHLY
  BI_WEEKLY // Every two weeks
  WEEKLY
  // SEMI_MONTHLY // Twice a month (e.g., 15th and last day) - more complex to define exact dates
}

model PayrollCycle {
  id            String                @id @default(cuid())
  name          String                @unique // e.g., "Monthly Salaried Employees", "Bi-Weekly Hourly Workers"
  frequency     PayrollCycleFrequency
  // For MONTHLY: dayOfMonth (1-31, or LAST_DAY)
  // For BI_WEEKLY/WEEKLY: weekDayAnchor (MONDAY, TUESDAY, ...) and an anchorDate to establish the cycle
  // These details can be stored as structured JSON or separate fields if needed for automation.
  // For simplicity now, we'll keep it high-level.
  description   String?               @db.Text
  effectiveDate DateTime              @db.Date // Date this cycle definition becomes active
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

enum PayElementType {
  EARNING                 // Gross earnings (e.g., Base Salary, Bonus, Overtime Pay)
  DEDUCTION               // Deductions from gross (e.g., Income Tax, Employee Social Security, Loan Repayment)
  CONTRIBUTION_EMPLOYER   // Employer contributions (e.g., Employer Social Security, Pension Fund)
  CONTRIBUTION_EMPLOYEE   // Employee contributions (often same as DEDUCTION but categorized differently for reporting)
  BENEFIT_TAXABLE         // Taxable benefits (e.g., Company Car value)
  BENEFIT_NON_TAXABLE     // Non-taxable benefits (e.g., certain health contributions)
  STATUTORY_DEDUCTION     // Deductions mandated by law (often pre-tax or post-tax specific)
  REIMBURSEMENT           // Non-taxable reimbursements (e.g., travel expenses)
}

enum PayElementCalculationRule {
  FIXED_AMOUNT            // A fixed monetary value
  PERCENTAGE_OF_BASE      // Percentage of a defined base salary component
  PERCENTAGE_OF_GROSS     // Percentage of total gross earnings
  HOURLY_RATE_TIMES_HOURS // Based on an hourly rate and hours worked (requires timesheet integration)
  PER_UNIT                // Based on units produced/sold etc.
  CUSTOM_FORMULA          // A defined formula or script (placeholder for complex logic)
  BALANCE_BASED           // e.g. Loan repayment until balance is zero
}

model PayElement {
  id                String                      @id @default(cuid())
  name              String                      @unique // e.g., "Basic Salary", "Federal Income Tax", "401k Employer Match"
  code              String?                     @unique // Optional short code for integrations/reporting
  type              PayElementType
  calculationRule   PayElementCalculationRule
  isTaxable         Boolean                     @default(false)
  isPensionable     Boolean                     @default(false) // Contributes to pension calculation base
  isRecurring       Boolean                     @default(true)  // Is it applied every pay cycle by default?
  currency          String                      @default("USD") // Default currency, can be overridden at EmployeePayElement
  processingOrder   Int                         @default(0)    // Order in which elements are processed (e.g., base first, then percentages, then taxes)
  description       String?                     @db.Text
  effectiveDate     DateTime                    @db.Date       @default(now())
  endDate           DateTime?                   @db.Date       // When this pay element definition is no longer active

  employeePayElements EmployeePayElement[]
  // salaryStructureElements SalaryStructureElement[] // If PayElements are part of a structure template

  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
}

// Defines a template/grouping of pay elements
model SalaryStructure {
  id                  String    @id @default(cuid())
  name                String    @unique // e.g., "Executive Level 1", "Software Engineer - Grade III"
  description         String?   @db.Text
  // salaryStructureElements SalaryStructureElement[]
  employeeSalaries    EmployeeSalary[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

